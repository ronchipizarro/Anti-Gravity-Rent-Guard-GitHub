# RentGuard App Production Environment Variables
# Copy these to your Vercel Project Settings for rentguard-app

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=RentGuard <noreply@contact.rentguard.us.com>
UNDERWRITER_EMAIL=francisco@usadamant.com

# Cross-site links and App URLs
NEXT_PUBLIC_APP_URL=https://app.rentguard.us.com
NEXT_PUBLIC_MARKETING_URL=https://rentguard.us.com

# Underwriter Dashboard Auth
NEXT_PUBLIC_UNDERWRITER_USER=ADMIN
NEXT_PUBLIC_UNDERWRITER_PASSWORD=ADMIN

# Dropbox Sign Configuration
DROPBOX_SIGN_API_KEY=your-dropbox-sign-api-key

# Stripe Configuration (keys to be added later)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Fee Configuration
FEE_GREEN_BASE=0.05
FEE_GREEN_HIGH_INCOME=0.04
FEE_GREEN_HIGH_INCOME_THRESHOLD=5
FEE_YELLOW_MIN=0.06
FEE_YELLOW_MAX=0.10
FEE_YELLOW_DEFAULT=0.08
PAYMENT_DUE_DAYS=7
